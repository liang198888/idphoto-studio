/* 首页样式 */
.container {
  padding-bottom: 40rpx;
}

/* 顶部品牌区 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
}

.logo {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.logo-icon {
  font-size: 56rpx;
}

.logo-text {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.brand-subtitle {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.free-badge {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #52c41a 0%, #95de64 100%);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

/* 上传区域 */
.upload-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.upload-area {
  border: 3rpx dashed var(--border-color);
  border-radius: var(--radius-lg);
  padding: 60rpx 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  transition: all 0.3s ease;
}

.upload-area:active {
  border-color: var(--accent-color);
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: var(--text-muted);
}

.current-file {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #f0fdf4;
  border-radius: var(--radius-md);
  margin-top: 20rpx;
  border: 1rpx solid #bbf7d0;
}

.file-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.file-icon {
  font-size: 36rpx;
}

.file-name {
  font-size: 26rpx;
  color: var(--text-primary);
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-remove {
  font-size: 40rpx;
  color: var(--text-muted);
  padding: 8rpx;
}

/* 规格选择 */
.spec-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.spec-item {
  padding: 24rpx 16rpx;
  background: var(--bg-light);
  border-radius: var(--radius-md);
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.spec-item.active {
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
  border-color: var(--accent-color);
}

.spec-name {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.spec-size {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 背景颜色 */
.color-options {
  display: flex;
  gap: 20rpx;
}

.color-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  background: var(--bg-light);
  transition: all 0.3s ease;
}

.color-item.active {
  border-color: var(--accent-color);
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
}

.color-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  box-shadow: var(--shadow-sm);
}

.color-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 高级选项 */
.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.option-row:last-child {
  border-bottom: none;
}

.option-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.picker-value {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 8rpx 16rpx;
  background: var(--bg-light);
  border-radius: var(--radius-sm);
}

/* 生成按钮 */
.action-section {
  margin-top: 40rpx;
}

.generate-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.price-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.separator {
  color: var(--border-color);
}

/* 使用说明 */
.help-section {
  margin-top: 32rpx;
}

.help-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.help-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.help-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.help-dot {
  color: var(--accent-color);
  font-weight: bold;
}
