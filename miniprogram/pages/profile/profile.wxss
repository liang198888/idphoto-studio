/* 个人中心样式 */
.user-card {
  margin-bottom: 24rpx;
}

.user-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid var(--accent-color);
  box-shadow: var(--shadow-md);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.user-id {
  font-size: 24rpx;
  color: var(--text-muted);
}

.login-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, var(--accent-color) 0%, #764ba2 100%);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #fff;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border-color);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent-color);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 会员卡片 */
.member-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  margin-bottom: 24rpx;
}

.member-card .member-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.member-icon {
  font-size: 48rpx;
}

.member-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.member-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.renew-btn {
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.3);
  color: #fff;
}

/* 菜单卡片 */
.menu-card {
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-muted);
}

.menu-value {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-right: 12rpx;
}

.version-info {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: var(--text-muted);
}

.copyright {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}
