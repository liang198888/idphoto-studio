/* 订单列表样式 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #e8ecf1 100%);
}

.filter-tabs {
  margin-bottom: 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  background: transparent;
}

.tab-count {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--danger-color);
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 32rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}

.back-btn,
.spacer {
  font-size: 28rpx;
  padding: 12rpx 24rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-bottom: 40rpx;
}

.make-btn {
  width: 300rpx;
  height: 80rpx;
  font-size: 28rpx;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  cursor: pointer;
  transition: all 0.3s ease;
}

.order-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.order-id {
  font-size: 24rpx;
  color: var(--text-muted);
  font-family: monospace;
}

.order-status {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-pending {
  background: #fff7e6;
  color: #faad14;
}

.status-paid {
  background: #f6ffed;
  color: #52c41a;
}

.status-failed {
  background: #fff1f0;
  color: #f5222d;
}

/* 订单主体 */
.order-body {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.order-images {
  position: relative;
  flex-shrink: 0;
}

.order-thumb {
  width: 160rpx;
  height: 220rpx;
  border-radius: var(--radius-md);
  background: var(--bg-light);
}

.image-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  padding: 4rpx 12rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 20rpx;
  border-radius: 12rpx;
}

.order-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.order-spec {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.spec-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.spec-bg {
  padding: 4rpx 12rpx;
  background: var(--bg-light);
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  color: var(--text-secondary);
}

.order-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.meta-separator {
  color: var(--text-muted);
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.product-desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

.order-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--danger-color);
}

.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-time {
  font-size: 24rpx;
  color: var(--text-muted);
}

.order-actions {
  display: flex;
  gap: 12rpx;
}

.mini-btn {
  height: 56rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

/* 加载更多 */
.load-more,
.no-more {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}
