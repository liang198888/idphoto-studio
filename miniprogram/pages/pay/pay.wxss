/* pages/pay/pay.wxss - 支付页样式 */
.container {
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.order-card {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.order-item:last-child {
  border-bottom: none;
}

.order-image {
  width: 120rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  margin-right: 20rpx;
  background: var(--bg-light);
}

.order-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-spec {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.order-desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

.order-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--danger-color);
}

.payment-section {
  margin-bottom: 24rpx;
}

.method-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.method-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-light);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.method-item.active {
  border-color: var(--accent-color);
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
}

.method-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.method-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.method-check {
  font-size: 32rpx;
  color: var(--accent-color);
}

.coupon-section {
  margin-bottom: 24rpx;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.coupon-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: linear-gradient(135deg, #fff5f5 0%, #ffe0e0 100%);
  border-radius: var(--radius-md);
  border-left: 4rpx solid var(--danger-color);
}

.coupon-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--danger-color);
}

.coupon-condition {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 0 20rpx;
}

.coupon-btn {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  background: var(--bg-white);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
}

.notice-section {
  margin-bottom: 32rpx;
}

.notice-text {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
}

.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16px rgba(0,0,0,0.08);
}

.pay-button {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--accent-color) 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  box-shadow: 0 4px 16px rgba(102, 126, 234, 0.3);
}

.cancel-button {
  width: 100%;
  height: 80rpx;
  margin-top: 16rpx;
}

.service-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

.service-link {
  color: var(--accent-color);
  text-decoration: underline;
}
