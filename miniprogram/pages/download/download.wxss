/* pages/download/download.wxss - 下载页样式 */
.container {
  padding: 24rpx;
}

/* 成功卡片 */
.success-card {
  text-align: center;
  background: linear-gradient(135deg, #52c41a 0%, #95de64 100%);
  color: #fff;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
}

.success-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.success-desc {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 订单信息 */
.order-info {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-muted);
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
}

.total-row .info-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.price-total {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--danger-color);
}

/* 下载区 */
.download-section {
  margin-bottom: 24rpx;
}

.version-options {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.version-item {
  flex: 1;
  padding: 24rpx;
  background: var(--bg-light);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.version-item.active {
  border-color: var(--accent-color);
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
}

.version-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.version-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.version-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #e0e0e0;
  color: #666;
}

.version-badge.recommended {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #fff;
}

.version-badge.active {
  background: linear-gradient(135deg, var(--accent-color) 0%, #764ba2 100%);
  color: #fff;
}

.version-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.version-specs {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.download-btn {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.download-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.5;
}

/* 预览卡片 */
.preview-card {
  margin-bottom: 24rpx;
}

.image-scroll {
  white-space: nowrap;
  margin: 0 -12rpx;
  padding: 0 12rpx;
}

.image-grid {
  display: inline-flex;
  gap: 16rpx;
}

.image-item {
  width: 160rpx;
  height: 220rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

/* 操作列表 */
.action-list {
  margin-bottom: 24rpx;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.action-item:last-child {
  border-bottom: none;
}

.action-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.action-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.action-arrow {
  font-size: 32rpx;
  color: var(--text-muted);
}
