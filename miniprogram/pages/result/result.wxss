/* 结果页样式 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}

.back-btn,
.share-btn {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 12rpx 24rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 图片展示区 */
.image-showcase {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.image-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

.image-scroll {
  white-space: nowrap;
  margin: 0 -12rpx;
  padding: 0 12rpx;
}

.image-grid {
  display: inline-flex;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 220rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.image-item.active {
  border-color: var(--accent-color);
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.2);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  border-radius: 12rpx;
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}

.main-preview {
  margin-top: 24rpx;
  text-align: center;
}

.main-image {
  max-width: 100%;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.image-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 背景切换 */
.bg-switcher {
  margin-bottom: 24rpx;
}

.bg-options {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.bg-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  background: var(--bg-light);
  min-width: 100rpx;
  transition: all 0.3s ease;
}

.bg-option.active {
  border-color: var(--accent-color);
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
}

.bg-swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  box-shadow: var(--shadow-sm);
}

.bg-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 价格卡片 */
.price-card {
  margin-bottom: 24rpx;
}

.price-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.free-tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #52c41a 0%, #95de64 100%);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.price-options {
  display: flex;
  gap: 16rpx;
}

.price-option {
  flex: 1;
  padding: 24rpx;
  background: var(--bg-light);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  text-align: center;
  transition: all 0.3s ease;
  position: relative;
}

.price-option.active {
  border-color: var(--accent-color);
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
}

.option-label {
  position: absolute;
  top: -12rpx;
  right: 16rpx;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  border-radius: 12rpx;
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}

.option-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.option-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.option-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.option-desc {
  font-size: 22rpx;
  color: var(--text-muted);
}

.option-price {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

.original-price {
  font-size: 24rpx;
  color: var(--text-muted);
  text-decoration: line-through;
}

.current-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--danger-color);
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.save-btn,
.pay-btn,
.success-btn {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-success {
  background: linear-gradient(135deg, #52c41a 0%, #95de64 100%);
  color: #fff;
}

/* 下载区域 */
.download-section {
  margin-top: 24rpx;
}

.download-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.download-btn {
  width: 100%;
  height: 80rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.download-btn.secondary {
  opacity: 0.8;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}

.modal.show {
  display: flex;
}

.modal-content {
  background: #fff;
  border-radius: var(--radius-xl);
  width: 100%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  font-size: 48rpx;
  color: var(--text-muted);
  padding: 8rpx;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  overflow-y: auto;
}

.order-summary {
  margin-bottom: 24rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.summary-label {
  color: var(--text-secondary);
}

.summary-value {
  color: var(--text-primary);
  font-weight: 500;
}

.summary-row.total {
  border-top: 1rpx solid var(--border-color);
  margin-top: 12rpx;
  padding-top: 20rpx;
  font-size: 32rpx;
}

.price-total {
  color: var(--danger-color);
  font-weight: 700;
  font-size: 36rpx;
}

.payment-method {
  margin-top: 24rpx;
}

.method-label {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
}

.method-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: var(--bg-light);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-primary);
}

.method-desc {
  font-size: 22rpx;
  color: var(--text-muted);
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--border-color);
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}
