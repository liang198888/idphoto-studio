<!-- pages/share/share.wxml - 分享页 -->
<view class="container">
  <view class="share-card card">
    <view class="card-title">🎁 生成分享海报</view>
    <view class="poster-preview">
      <image src="{{posterUrl}}" mode="widthFix" class="poster-image" />
    </view>
    <view class="poster-actions">
      <button class="btn btn-primary save-btn" bindtap="savePoster">保存到相册</button>
      <button class="btn btn-outline cancel-btn" bindtap="goBack">返回</button>
    </view>
  </view>
  
  <view class="invite-section card">
    <view class="section-title">💝 邀请好友得奖励</view>
    <view class="invite-info">
      <text class="invite-text">每邀请一位好友成功下单，您可获得 ¥2 返现</text>
      <text class="invite-tip">好友首单立减 ¥2</text>
    </view>
    <button class="btn btn-outline copy-btn" bindtap="copyInviteCode">复制邀请码</button>
  </view>
</view>
